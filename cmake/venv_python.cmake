function(find_venv_python)
    if(EXISTS "${PROJECT_SOURCE_DIR}/.venv/bin/python")
        set(ECHO_VENV_PYTHON "${PROJECT_SOURCE_DIR}/.venv/bin/python" PARENT_SCOPE)
        set(ECHO_VENV_SCRIPTS "${PROJECT_SOURCE_DIR}/.venv/bin" PARENT_SCOPE)
    elseif(EXISTS "${PROJECT_SOURCE_DIR}/.venv/Scripts/python.exe")
        set(ECHO_VENV_PYTHON "${PROJECT_SOURCE_DIR}/.venv/Scripts/python.exe" PARENT_SCOPE)
        set(ECHO_VENV_SCRIPTS "${PROJECT_SOURCE_DIR}/.venv/Scripts" PARENT_SCOPE)
    elseif(EXISTS "${PROJECT_SOURCE_DIR}/.venv/bin/python3")
        set(ECHO_VENV_PYTHON "${PROJECT_SOURCE_DIR}/.venv/bin/python3" PARENT_SCOPE)
        set(ECHO_VENV_SCRIPTS "${PROJECT_SOURCE_DIR}/.venv/bin" PARENT_SCOPE)
    elseif(EXISTS "${PROJECT_SOURCE_DIR}/.venv/Scripts/python3.exe")
        set(ECHO_VENV_PYTHON "${PROJECT_SOURCE_DIR}/.venv/Scripts/python3.exe" PARENT_SCOPE)
        set(ECHO_VENV_SCRIPTS "${PROJECT_SOURCE_DIR}/.venv/Scripts" PARENT_SCOPE)
    else()
        set(ECHO_VENV_PYTHON "" PARENT_SCOPE)
    endif()
endfunction()